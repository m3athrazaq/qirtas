// Cloudflare Pages settings for the web app and its sync server (functions/api).
// The D1 database keeps the accounts and every workspace's update log; the server creates its
// tables on first use. Bindings set here replace the ones in the Pages dashboard (secrets, such as
// ANTHROPIC_API_KEY for the writing assistant, stay in the dashboard).
{
  "name": "qirtas",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qirtas-sync",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
